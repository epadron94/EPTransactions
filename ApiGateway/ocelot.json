{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/ConsultaDemo",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 15400
        }
      ],
      "UpstreamPathTemplate": "/servicio-demo/consultademo",
      "UpstreamHttpMethod": [ "GET" ]
    },
    {
      "DownstreamPathTemplate": "/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 15400
        }
      ],
      "UpstreamPathTemplate": "/servicio-demo/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE", "PATCH" ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:15500"
  }
}
